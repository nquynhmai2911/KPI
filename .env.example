# ==============================================================================
# HỆ THỐNG ĐÁNH GIÁ KPI & HIỆU QUẢ CÔNG VIỆC (ENTERPRISE & PUBLIC SECTOR)
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME="Hệ thống Đánh giá KPI & Xếp loại Cán bộ"
APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=kpi_admin
DB_PASSWORD=KpiSecret2026!
DB_NAME=kpi_system_db
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Redis Configuration (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisKpi2026!

# JWT Authentication
JWT_ACCESS_SECRET=kpi_jwt_access_super_secret_key_2026_gov_enterprise_signature_token
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=kpi_jwt_refresh_super_secret_key_2026_gov_enterprise_refresh_token
JWT_REFRESH_EXPIRES_IN=7d

# 2FA Two-Factor Authentication (TOTP)
TWO_FACTOR_APP_NAME="Hệ thống KPI Quốc gia"

# Storage Configuration (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioKpi2026Secret!
MINIO_BUCKET_NAME=kpi-proof-documents

# System Defaults & Rules
DEFAULT_OPERATING_MODE=HYBRID # ENTERPRISE | GOVERNMENT | HYBRID
GOV_MAX_EXCELLENT_PERCENTAGE=20 # Ngưỡng tối đa 20% HTXSNV theo NĐ 48/2023/NĐ-CP
ENABLE_AUDIT_LOG=true
